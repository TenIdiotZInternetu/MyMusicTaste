@using MyMusicTaste.Components.Page_Home
@namespace MyMusicTaste.Components.Page_Auth
@attribute [Route(ROUTE_TEMPLATE)]

@* TODO: Split/Merge Login and Signup, idk just make it consistent*@
<div class="d-flex justify-content-around gap-1">
    <div class="w-25">
        <p>Log in</p>
        <form method="post" action="@AuthController.LOGIN_ROUTE">
            <div class="form-floating row my-1">
                <input class="form-control" name="Username" id="inputName"/>
                <label for="inputName">Username</label>
            </div>
            <div class="form-floating row my-1">
                <input class="form-control" name="Password" id="inputPass"/>
                <label for="inputPass">Password</label>
            </div>
            <input type="hidden" name="ReturnUrl" value="@HomePage.GetRoute()"/>
            <button class="my-3 btn btn-primary" type="submit">Submit</button>
        </form>
    </div>
    <div class="vr"></div>
    <div class="w-25">
        <p>Or sign up if you're new</p>
        <UserSignupForm/>
    </div>
</div>