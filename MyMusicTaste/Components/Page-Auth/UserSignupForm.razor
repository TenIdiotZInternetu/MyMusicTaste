@using MyMusicTaste.Database

@inject IIdentityProvider Identity

<EditForm Model="_newUserSignup" OnValidSubmit="SubmitAsync" FormName="UserSignup">
    <DataAnnotationsValidator/>
    <div class="form-floating row my-1">
        <InputText class="form-control" @bind-Value="@_newUserSignup.Email" id="inputMail"/>
        <label for="inputMail">Email</label>
    </div>
    <div class="form-floating row my-1">
        <InputText class="form-control" @bind-Value="@_newUserSignup.Username" id="inputName"/>
        <label for="inputName">Username</label>
    </div>
    <div class="form-floating row my-1">
        <InputText type="password" class="form-control" @bind-Value="@_newUserSignup.Password" id="inputPass"/>
        <label for="inputPass">Password</label>
    </div>
    <button class="my-3 btn btn-primary" type="submit">Submit</button>
</EditForm>

@foreach (var error in _errors) 
{
    <p>@error</p>
}

@if (_submitted)
{
    <p>Submitted!</p>
    <p>@_newUserSignup.Username</p>
}