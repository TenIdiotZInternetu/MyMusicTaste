@using MyMusicTaste.Components.Misc

@inject NavigationManager Navigation

@rendermode InteractiveServer

@if (_componentState == ComponentState.Loaded)
{
    <button type="button" @onclick="GoToSongPage" class="list-item-medium simple-border">
        <Thumbnail ImageLink="@_song!.CoverImageLink"></Thumbnail>
        
        <div class="text-start">
            <p class="item-text song-title">@_song!.Title</p>
            <p class="item-text">@_song!.Author - @_song!.Album</p>
        </div>
        <div class="rating-border">
            <p class="item-text">@_shownValue</p>
        </div>
    </button>
}
