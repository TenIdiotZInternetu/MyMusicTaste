@using MyMusicTaste.Components.Misc

@inject NavigationManager Navigation

@rendermode InteractiveServer

@if (_componentState == ComponentState.Loaded)
{
    <button type="button" @onclick="GoToSongPage" class="list-item-medium">
        <Thumbnail ImageLink="@_song!.CoverImageLink"></Thumbnail>
        
        <div class="px-2 text-start">
            <p class="item-text song-title">@_song!.Title</p>
            <p class="item-text">@_song!.Author - @_song!.Album</p>
        </div>
        <div>
            <div class="border rounded-circle p-2">
                <p class="item-text">@Rating.Rating</p>
            </div>
        </div>
    </button>
}
