@using MyMusicTaste.Components.Misc

@inject NavigationManager Navigation

@rendermode InteractiveServer

@if (_componentState == ComponentState.Loaded)
{
    <button type="button" @onclick="GoToSongPage" class="list-item-medium simple-border">
        <Thumbnail ImageLink="@_song!.CoverImageLink"></Thumbnail>
        
        <div class="text-start">
            <p class="item-text song-title">@_song!.Title</p>
            <p class="item-text">@_song!.Author - @_song!.Album</p>
        </div>
        <div class="rating-border" @onclick:stopPropagation="true">
            <input class="form-control-plaintext text-center" type="number" min="0" max="100"
                   value="@_shownValue"
                   @oninput="ChangeRating"
                   @onblur="@SaveRatingAsync"
                   @onkeydown="HandleKeyAsync"/>
        </div>
    </button>
}
