@using MyMusicTaste.Components.Misc

@inject NavigationManager Navigation

@rendermode InteractiveServer

@if (Rating is { IsValid: true })
{
    <button type="button" @onclick="GoToSongPage" class="list-item-medium">
        <Thumbnail ImageLink="@Song!.CoverImageLink"></Thumbnail>
        
        <div class="px-2 text-start">
            <p class="item-text song-title">@Song!.Title</p>
            <p class="item-text">@Song!.Author - @Song!.Album</p>
        </div>
        <div>
            <div class="border rounded-circle p-2">
                <p class="item-text">@Rating.Rating</p>
            </div>
        </div>
    </button>
}
