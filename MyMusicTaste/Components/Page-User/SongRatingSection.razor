@using Microsoft.IdentityModel.Tokens
@using MyMusicTaste.Components.Misc

@if (_ratingItems.IsNullOrEmpty())
{
    <div>No ratings yet :(</div>
}
else
{
    int firstRating = _ratingItems!.First().Rating;
        
    <div>
        @foreach (var item in _ratingItems!)
        {
            int prevRating = firstRating;
            if (firstRating != item.Rating)
            {
                <Dropzone OnDrop="@(_ => SaveDraggedItem(prevRating))"
                          AutoDeactivate="false" OnDragEnter="@ChangeDropzone"/>
                <hr class="m-2"/>   
            }
            if (item.Rating - prevRating > 1)
            {
                <Dropzone OnDrop="@(_ => SaveDraggedItem(prevRating + 1))"
                          AutoDeactivate="false" OnDragEnter="@ChangeDropzone"/>
                <hr class="m-2"/>
            }
            
            <Dropzone OnDrop="@(_ => SaveDraggedItem(item.Rating))"
                      AutoDeactivate="false" OnDragEnter="@ChangeDropzone"/>

            <div draggable="true" class="position-relative z-1"
                 @ondragstart="@(_ => StartDragging(item))"
                 @ondragend="@(_ => StopDragging())"
                 @ondragover:preventDefault="true">
                <SongRatingItem OnRatingSaved="@ReorderRatings" @key="item.Id" Rating="item"/>
            </div>
            firstRating = item.Rating;
        }
    </div>
}