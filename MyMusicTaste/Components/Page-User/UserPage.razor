@using Microsoft.IdentityModel.Tokens
@using MyMusicTaste.Database
@using MyMusicTaste.Database.Operations
@using MyMusicTaste.Models
@using MyMusicTaste.Components.Misc
@using Microsoft.AspNetCore.Components.Authorization
@using MyMusicTaste.Components.Dialogs

@namespace MyMusicTaste.Components.Page_User
@attribute [Route(ROUTE_TEMPLATE)]

<ConfirmDialog @ref="_unsavedChangesDialog"
               Title="Unsaved Changes" 
               Question="There have been unsaved changes. Do you really want to stop editing?"/>

<InputDialog @ref="_pictureLinkDialog"
             Title="Enter a valid URL to your picture"
             Placeholder="https://www.imgur.com/gallery/awesome"/>

@if (_pageState == PageState.Loading)
{
    <PageTitle>Loading...</PageTitle>
    <p>Loading...</p>
}

@if (_pageState == PageState.UserNotFound)
{
    <PageTitle>404</PageTitle>
    <p>User not found</p>
}

@if (_pageState == PageState.Loaded)
{
    @if (_inEditMode)
    {
        <div class="backdrop"></div>
    }
    <PageTitle>@_user!.Username</PageTitle>
    <div class="general-info">
        <div class="z-101 general-info-side" @onclick="@ChangeProfilePicture">
            <Thumbnail ImageLink="@_profilePicLink" AltText="@(_user!.Username + "'s Profile Picture")"/>
        </div>
        <div class="general-info-main">
            <div class="d-flex align-items-center">
                <div class="h1 mr-auto ">@_user!.Username</div>
                @if (_ownerAuthorized)
                {
                    @if (_inEditMode)
                    {
                        <button class="btn z-101 m-1 h-50 btn-@_saveBtnStyle" @onclick="SaveChanges">Save</button>
                        <button class="btn z-101 m-1 h-50 btn-danger" @onclick="CloseEditMode">Stop editing</button>

                        @if (_saving)
                        {
                            <p class="">Saving...</p>
                        }
                    }
                    else
                    {
                        <button class="btn z-101 h-50 btn-primary" @onclick="@OpenEditMode">Edit</button>
                    }
                }
            </div>

            <h4>About Me:</h4>
            <textarea readonly="@(!_inEditMode)" class="form-control z-101 position-relative"
                      @onchange="@ChangeAboutMe" value="@_aboutMeText">
            </textarea>
        </div>
    </div>
    
    @if (_ratings.IsNullOrEmpty())
    {
        <div>No ratings yet :(</div>
    }
    else
    {
        int lastRating = _ratings!.First().Rating;
        
        <div class="list-group">
            @foreach (var rating in _ratings!)
            {
                <SongRatingItem @key="rating.Id" Rating="rating"/>
    
                if (lastRating != rating.Rating)
                {
                    <hr/>
                }
    
                lastRating = rating.Rating;
            }
        </div>
    }
}