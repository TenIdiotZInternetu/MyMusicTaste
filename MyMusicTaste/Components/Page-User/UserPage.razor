@using Microsoft.IdentityModel.Tokens
@using MyMusicTaste.Database
@using MyMusicTaste.Database.Operations
@using MyMusicTaste.Models

@namespace MyMusicTaste.Components.Page_User
@attribute [Route(ROUTE_TEMPLATE)]

@inject IDbRepository<User> UserRepository
@inject ISongRatingListing RatingListing
@inject IIdentityProvider Identity


@if (_pageState == PageState.Loading)
{
    <PageTitle>Loading...</PageTitle>
    <p>Loading...</p>
}

@if (_pageState == PageState.UserNotFound)
{
    <PageTitle>404</PageTitle>
    <p>User not found</p>
}

@if (_pageState == PageState.Loaded)
{
    <PageTitle>@_user!.Username</PageTitle>
    
    <h1>@_user!.Username</h1>
    
    <h4>About Me:</h4>
    <p>@_aboutMeText</p>
    
    @if (_ratings.IsNullOrEmpty())
    {
        <div>No ratings yet :(</div>
    }
    else
    {
        <div class="list-group">
            @{
                int lastRating = _ratings!.First().Rating;
            }
            @foreach (var rating in _ratings!)
            {
                <SongRatingItem @key="rating.Id" Rating="rating"/>
    
                if (lastRating != rating.Rating)
                {
                    <hr/>
                }
    
                lastRating = rating.Rating;
            }
        </div>
    }
}