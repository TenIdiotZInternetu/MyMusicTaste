@using Microsoft.AspNetCore.Components.Authorization
@using MyMusicTaste.Components.Page_Auth
@using MyMusicTaste.Components.Page_Home
@using MyMusicTaste.Components.Page_Search

<nav class="navbar sticky-top navbar-expand-lg navbar-dark bg-dark px-3">
    <a class="navbar-brand mx-5" href="">MyMusicTaste</a>

    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
        <div class="nav-item">
            <NavLink class="nav-link" href="@HomePage.GetRoute()" Match="NavLinkMatch.All">
                Home
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="@SearchPage.GetRoute()" Match="NavLinkMatch.All">
                Search
            </NavLink>
        </div>
    </div>
    
    <AuthorizeView>
        <NotAuthorized>
            <NavLink class="nav-link" href="@LoginPage.GetRoute()" Match="NavLinkMatch.All">
                Login
            </NavLink>
        </NotAuthorized>
        <Authorized>
            <Logout/>
        </Authorized>
    </AuthorizeView>
    <div class="nav-item">
    </div>
</nav>