@typeparam TValue
@typeparam TLabel

<div class="column-container">
    @foreach (var colHeight in _heights)
    {
        <div class="column" style="height:@colHeight;"></div>
    }
</div>
<div class="my-1 d-flex justify-content-between">
    @foreach (var label in Labels)
    {
        <span>@label</span>
    }
</div>