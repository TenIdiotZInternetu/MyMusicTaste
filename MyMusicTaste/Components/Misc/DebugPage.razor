@page "/debug"
@using MyMusicTaste.Components.Dialogs

<ConfirmDialog @ref="_dialog" Question="Am i working?" CancelText="AAA"/>
<button @onclick="Click">Dialog</button>

@if (_success)
{
    <p>im so good</p>
}

@code {
    private bool _success;
    private ConfirmDialog _dialog;
    
    private async Task Click()
    {
        var result = await _dialog.OpenDialog();
        _success = result.Result;
        StateHasChanged();
    }
}