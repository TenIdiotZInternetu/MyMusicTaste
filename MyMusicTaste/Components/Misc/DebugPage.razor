@page "/debug"
@using MyMusicTaste.Components.Dialogs

<InputDialog @ref="_dialog" Title="Am i working?" CancelText="AAA"/>
<button @onclick="Click">Dialog</button>

@if (_success)
{
    <p>@_message</p>
}

@code {
    private string _message;
    private bool _success;
    private InputDialog _dialog;
    
    private async Task Click()
    {
        var result = await _dialog.OpenDialog();
        _success = result.WasConfirmed;
        _message = result.Result ?? "Didnt confirm";
        StateHasChanged();
    }
}