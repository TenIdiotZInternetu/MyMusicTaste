@using MyMusicTaste.Components.Misc

@namespace MyMusicTaste.Components.Page_Search
@inject NavigationManager Navigation

@rendermode InteractiveServer

<button type="button" @onclick="GoToSongPage" class="list-item-medium simple-border">
    <Thumbnail ImageLink="@Song!.CoverImageLink"></Thumbnail>
    
    <div class="text-start">
        <p class="item-text song-title">@Song.Title</p>
        <p class="item-text">@Song.Author - @(Song.Album ?? "Unknown")</p>
    </div>
</button>