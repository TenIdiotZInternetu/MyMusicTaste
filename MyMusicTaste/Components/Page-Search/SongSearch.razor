@using MyMusicTaste.Components.Page_SongSubmission
@using MyMusicTaste.Models

@namespace MyMusicTaste.Components.Page_Search
@inherits SearchComponent<Song>

@rendermode InteractiveServer


@if (Results == null)
{
    <p>Start typing in the search bar...</p>
}
else
{
    <div class="list-group">
        @foreach (var song in Results)
        {
            <SongSearchItem Song="song"/>
        }
    </div>
}

<p class="m-2">
    Couldn't find the song you were looking for? <br/>
    <a href="@SongSubmissionPage.GetRoute()">Add it to our database!</a>
</p>