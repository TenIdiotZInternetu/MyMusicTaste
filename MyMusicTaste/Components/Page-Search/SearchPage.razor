@namespace MyMusicTaste.Components.Page_Search
@attribute [Route(RouteTemplate)]

@rendermode InteractiveServer

<InputText class="form-control mb-3" @oninput="UpdateQuery" @bind-Value="_searchQuery"/>

<div class="nav nav-tabs my-3">
    <a class="nav-link @CssIsActive(Tab.All)" @onclick="ChangeTabToAll">All</a>
    <a class="nav-link @CssIsActive(Tab.Songs)" @onclick="ChangeTabToSongs">Songs</a>
    <a class="nav-link @CssIsActive(Tab.Users)" @onclick="ChangeTabToUsers">Users</a>
</div>

@if (_currentTab == Tab.All)
{
    <h4 class="m-0">Songs</h4>
    <hr class="my-3"/>
    <SongSearch Query="@_searchQuery" ResultsCount="4"/>
    
    <h4 class="m-0">Users</h4>
    <hr class="my-3"/>
    <UserSearch Query="@_searchQuery" ResultsCount="4"/>
}

@if (_currentTab == Tab.Songs)
{
    <SongSearch Query="@_searchQuery" ResultsCount="30"/>
}

@if (_currentTab == Tab.Users)
{
     <UserSearch Query="@_searchQuery" ResultsCount="30"/>
}