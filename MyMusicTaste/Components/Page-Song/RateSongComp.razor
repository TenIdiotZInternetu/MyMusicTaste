@if (_componentState == ComponentState.NotLoggedIn)
{
    <p>Log in to add this song to your collection!</p>
}
@if (_componentState == ComponentState.Unrated)
{
    <button class="btn btn-primary" @onclick="@AddRating">Add to collection</button>
}
@if (_componentState == ComponentState.Rated)
{
    <div>
        <p class="m-0">Your rating: @GetShownLabelValue()</p>
        <input class="form-range my-1" type="range" 
               value="@_initialInputValue" min="0" max="100" 
               @oninput="@ChangeRating" @onchange="@SaveNewRating"/>
        <button class="btn btn-danger w-100" @onclick="@RemoveRating">Remove from collection</button>
    </div>
}