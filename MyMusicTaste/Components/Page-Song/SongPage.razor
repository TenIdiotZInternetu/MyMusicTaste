@namespace MyMusicTaste.Components.Page_Song
@attribute [Route(ROUTE_TEMPLATE)]
@using MyMusicTaste.Utils
@using MyMusicTaste.Components.Misc
@using MyMusicTaste.Components.Comments
@using MyMusicTaste.Models

@if (_pageState == PageState.Loading)
{
    <PageTitle>Loading...</PageTitle>
    <p>Loading...</p>
}

@if (_pageState == PageState.SongNotFound)
{
    <PageTitle>404</PageTitle>
    <p>Song not found</p>
}

@if (_pageState == PageState.Loaded)
{
    <PageTitle>@_song!.Title</PageTitle>
    <div class="general-info">
        <div class="general-info-side">
            <Thumbnail ImageLink=@_song!.CoverImageLink AltText="@(_song.Title + "Cover Image")"/>
            <RateSongComp SongId="@SongId"/>
        </div>
        <div class="general-info-main">
            <h1>@_song!.Title</h1>
            <p>Author: @_song.Author</p>
            <p>Album: @(_song.Album ?? "Unknown")</p>
            <p>Genre: @(_song.Genre ?? "Unknown")</p>
            <p>Release Date: @(_song.ReleasDateValid ? _song.ReleaseDate : "Unknown")</p>

            @if (LinkValidation.IsSongLinkValid(_song.SourceLink))
            {
                <a href="@_song.SourceLink">Listen to this song</a>
            }
            else
            {
                <p>No source was provided :(</p>
            }
            
            @if (_statsCalculated)
            {
                <div class="d-flex flex-wrap gap-3 my-2">
                    <div class="stat-box">
                        <h3>Total Listeners:</h3>
                        <h1>@_stats!.TotalListens</h1>
                    </div> 
                    <div class="stat-box">
                        <h3>Average Rating:</h3>
                        <h1>@_stats!.AverageRating</h1>
                    </div>
                    <div class="stat-box">
                        <h3>Median Rating:</h3>
                        <h1>@_stats!.AverageRating</h1>
                    </div>
                    <div class="stat-box flex-basis-100">
                        <h3>Rating Distribution: </h3>
                        <Histogram MaxHeight="@(new CssSize(6, CssUnit.Rem))"
                                   Values="@_stats.RatingDistribution"
                                   Labels="@CreateHistogramLabels()"/>
                    </div>
                </div>
            }
            else
            {
                <p>Calculating statistics...</p>
            }
        </div>
    </div>
    <hr/>
    
    <CommentSection PageType="CommentPageType.Song" PageId="@SongId" ResultsCount="50"/>
}
