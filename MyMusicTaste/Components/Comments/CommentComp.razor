@using MyMusicTaste.Components.Misc
@using MyMusicTaste.Components.Dialogs

<ConfirmDialog @ref="_unsavedChangesDialog"
               Title="Unsaved Changes" 
               Question="There have been unsaved changes. Do you really want to stop editing?"/>

<ConfirmDialog @ref="_deleteCommentDialog"
               Title="Delete Comment"
               Question="Are you sure you want to delete this comment forever?"/>

@if (_state == CompState.Loaded)
{
    <div class="comment simple-border">
        <div class="comment-header">
            <Thumbnail onclick="@NavigateToUser" ImageLink="@_poster!.ProfilePictureLink"/>
            <h5 onclick="@NavigateToUser" class="p-0 m-0">@_poster.Username</h5>
            @if (!_inEditMode && _ownedByUser)
            {
                <button class="ml-auto btn btn-primary"
                        @onclick="OpenEditMode">Edit</button>
            }
            @if (_inEditMode && _ownedByUser)
            {
                <button class="ml-auto btn btn-@_saveBtnStyle"
                        @onclick="SaveChangesAsync">Save</button>
                <button class="btn btn-secondary"
                        @onclick="CloseEditMode">Close</button>
                @if (IsPosted)
                {
                    <button class="btn btn-danger"
                            @onclick="DeleteCommentAsync">Delete</button>
                }
            }
        </div>
        <hr class="m-2"/>
        <textarea readonly="@(!_inEditMode)" class="comment-content" maxlength="1000"
                  @oninput="@ChangeContent" value="@_content">
        </textarea>
        <span class="text-secondary m-1">
            @Comment.CreationTime
        </span>
        @if (_showLastEdit)
        {
            <span class="text-secondary m-0">- Last Edited @Comment.LastEditTime</span>
        }
    </div>
}
@if (_state == CompState.Deleted)
{
    <p class="text-secondary">Your comment has been deleted</p>
}
