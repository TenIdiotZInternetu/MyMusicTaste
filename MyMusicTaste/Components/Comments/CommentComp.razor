@using MyMusicTaste.Components.Misc
@if (Comment != null)
{
    <div class="comment simple-border">
        <div class="comment-header">
            <Thumbnail ImageLink="@_poster!.ProfilePictureLink"/>
            <h5 class="p-0 m-0">@_poster.Username</h5>
        </div>
        <hr class="m-2"/>
        <p class="comment-body">@Comment.Content</p>
        <p class="text-secondary m-0">@Comment.CreationTime</p>
    </div>
}
