@if (_state == ComponentState.Loaded)
{
    @if (!_newCommentShown)
    {
        <div class="d-flex justify-content-center">
            <button class="btn btn-primary" @onclick="ShowNewComment">
                Post a comment
            </button>
        </div>
    }
    else
    {
        <div class="m-2">
            <CommentComp OnEditModeClosed="CloseNewComment" IsNewComment="false"
                         Comment="@_newComment" @ref="@_newCommentComp"/>
        </div>
    }
    
    foreach (var comment in _comments)
    {
        <div class="m-2">
            <CommentComp Comment="@comment"/>
        </div>
    } 
}
