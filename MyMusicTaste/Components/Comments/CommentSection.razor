@if (_state == ComponentState.Loaded)
{
    @if (!_newCommentShown)
    {
        <div class="d-flex justify-content-center">
            <button class="btn btn-primary" @onclick="ShowNewComment">
                Post a comment
            </button>
        </div>
    }
    else
    {
        <CommentComp @ref="_newCommentComp" Comment="@_newComment" IsUnposted="true"/>
    }
    
    foreach (var comment in _comments)
    {
        <CommentComp Comment="@comment"/>
    } 
}
